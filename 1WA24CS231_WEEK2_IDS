start = input("Enter start state: ").replace(" ", "")
goal = input("Enter goal state: ").replace(" ", "")

moves = {
    0: [1, 3],
    1: [0, 2, 4],
    2: [1, 5],
    3: [0, 4, 6],
    4: [1, 3, 5, 7],
    5: [2, 4, 8],
    6: [3, 7],
    7: [4, 6, 8],
    8: [5, 7]
}

def move(state, old, new):
    s = list(state)
    s[old], s[new] = s[new], s[old]
    return "".join(s)

def dls(state, depth, path):

    if state == goal:
        return path

    if depth == 0:
        return None

    pos = state.index("_")

    for new_pos in moves[pos]:

        new_state = move(state, pos, new_pos)

        if new_state not in path:
            result = dls(new_state, depth - 1, path + [new_state])

            if result:
                return result

    return None


def ids():

    for depth in range(30):

        result = dls(start, depth, [start])

        if result:
            return result

    return None
solution = ids()

print("\nStart:", start)
print("Goal :", goal)

if solution:
    print("\nSolution:")

    for state in solution:
        print(state[:3])
        print(state[3:6])
        print(state[6:9])
        print()

    print("Number of moves:", len(solution) - 1)

else:
    print("No solution found.")
